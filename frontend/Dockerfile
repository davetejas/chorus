FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_LIVEKIT_URL=ws://localhost:7880
ARG VITE_LIVEKIT_API_KEY=devkey
ARG VITE_LIVEKIT_API_SECRET=devsecret
ENV VITE_LIVEKIT_URL=$VITE_LIVEKIT_URL
ENV VITE_LIVEKIT_API_KEY=$VITE_LIVEKIT_API_KEY
ENV VITE_LIVEKIT_API_SECRET=$VITE_LIVEKIT_API_SECRET
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
